# Database (PostgreSQL — Supabase or Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/legal_baba?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/legal_baba?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic Claude API (server-side only, never expose to client)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Object storage (S3-compatible / Supabase Storage)
STORAGE_ENDPOINT=""
STORAGE_BUCKET="legal-baba-documents"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="ap-south-1"

# Nepal payment gateways
ESEWA_MERCHANT_ID=""
ESEWA_SECRET_KEY=""
KHALTI_PUBLIC_KEY=""
KHALTI_SECRET_KEY=""
FONEPAY_MERCHANT_CODE=""
FONEPAY_SECRET_KEY=""
CONNECTIPS_MERCHANT_ID=""
CONNECTIPS_APP_ID=""
CONNECTIPS_APP_NAME=""
IME_PAY_MERCHANT_CODE=""
IME_PAY_SECRET_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Legal Baba"
